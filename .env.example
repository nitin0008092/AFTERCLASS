# ==============================================================================
# AFTERCLASS PRODUCTION & STAGING ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development. Never commit real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FOUNDER NOTIFICATIONS & EMAILS (RESEND)
# ------------------------------------------------------------------------------
# Email recipient for internal alerts whenever a new registration is submitted
AFTERCLASS_NOTIFY_EMAIL=afterclass121@gmail.com

# Resend API key (from https://resend.com/api-keys)
# If empty or not set, the app will log email notifications to the console without crashing.
RESEND_API_KEY=

# Verified sender address on your custom domain (e.g., updates@afterclass.in or AFTERCLASS <onboarding@resend.dev> for testing)
EMAIL_FROM="AFTERCLASS <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (POSTGRESQL + RLS)
# ------------------------------------------------------------------------------
# Supabase project URL and keys (from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service role key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Google Cloud Service Account Email with editor access to your sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=afterclass-sync@your-project.iam.gserviceaccount.com

# Service Account Private Key (keep \n escaped or formatted properly)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID from your private spreadsheet URL:
# https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ------------------------------------------------------------------------------
# 4. FOUNDER ADMIN ACCESS SECURITY
# ------------------------------------------------------------------------------
# Secret master passkey for Laxya, Nitin, and Mimansha to access /admin dashboard
ADMIN_SECRET_KEY=afterclass-founder-2026
